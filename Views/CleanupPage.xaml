<Page x:Class="SolventUI.Views.CleanupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:views="clr-namespace:SolventUI.Views"
      xmlns:conv="clr-namespace:SolventUI.Converters"
      Background="{DynamicResource SolventBgBrush}"
      Opacity="0">

    <Page.Resources>
        <conv:BoolToRiskBrushConverter x:Key="RiskToBrush" />
        <conv:BoolToVisibilityConverter x:Key="RiskToVisibility" />
    </Page.Resources>

    <Page.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource PageEnterStoryboard}" />
        </EventTrigger>
    </Page.Triggers>
    <Page.RenderTransform>
        <TranslateTransform />
    </Page.RenderTransform>

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource Nav_Cleanup}" Style="{DynamicResource SolventSectionTitle}" />
            <TextBlock Text="{DynamicResource Cleanup_Subtitle}"
                       Style="{DynamicResource SolventSectionSubtitle}" />
        </StackPanel>

        <views:OperationProgressBar x:Name="ProgressPanel" Grid.Row="1" CancelRequested="Progress_OnCancelRequested" />

        <!-- Deep Clean: scan-then-select category list, replacing the old blind "Clean now" button -->
        <Border Grid.Row="2" Style="{DynamicResource SolventCard}" Padding="0" Margin="0,0,0,16" x:Name="ScanCard" MaxHeight="360">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="18,16,18,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Cleanup_TempTitle}" FontWeight="SemiBold" FontSize="15"
                                   Foreground="{DynamicResource SolventTextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Cleanup_TempDesc}"
                                   FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SolventTextSecondaryBrush}" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="{DynamicResource Cleanup_ScanButton}" Appearance="Primary" Padding="18,10"
                               Click="Scan_OnClick" x:Name="ScanButton" VerticalAlignment="Top">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Search24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>

                <DockPanel Grid.Row="1" Margin="18,10,18,6" x:Name="ScanToolbar" Visibility="Collapsed" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:Button Content="{DynamicResource Cleanup_SelectAll}" Appearance="Secondary" Padding="12,4"
                                   Click="SelectAllCategories_OnClick" />
                        <ui:Button Content="{DynamicResource Cleanup_SelectNone}" Appearance="Secondary" Padding="12,4"
                                   Margin="8,0,0,0" Click="SelectNoneCategories_OnClick" />
                    </StackPanel>
                    <TextBlock x:Name="ScanTotalText" FontWeight="SemiBold" FontSize="14" Margin="0,0,12,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource SolventAccentBrush}" />
                </DockPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="18,0,18,4" x:Name="CategoriesScroll" Visibility="Collapsed">
                    <ItemsControl x:Name="CategoriesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource SolventBorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Top" Margin="0,2,12,0" />
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5"
                                                           Foreground="{DynamicResource SolventTextPrimaryBrush}" />
                                                <Border Background="{Binding IsCaution, Converter={StaticResource RiskToBrush}}"
                                                        CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                        Visibility="{Binding IsCaution, Converter={StaticResource RiskToVisibility}}">
                                                    <TextBlock Text="{DynamicResource Cleanup_RiskCaution}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SolventTextSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Top" Margin="12,2,0,0"
                                                   Foreground="{DynamicResource SolventTextPrimaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="3" Margin="18,10,18,16" x:Name="CleanBar" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="SelectionSummaryText" FontSize="12"
                               VerticalAlignment="Center" Foreground="{DynamicResource SolventTextSecondaryBrush}" />
                    <ui:Button Grid.Column="1" Content="{DynamicResource Cleanup_CleanSelectedButton}" Appearance="Primary"
                               Padding="18,10" Click="CleanSelected_OnClick" x:Name="CleanSelectedButton" />
                </Grid>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="3" Columns="4" Margin="0,0,0,16" Height="120" VerticalAlignment="Top">
            <Border Style="{DynamicResource SolventCard}" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="StartupCard_OnClick">
                <StackPanel>
                    <ui:SymbolIcon Symbol="AppsList24" Foreground="{DynamicResource SolventAccentBrush}" FontSize="22" />
                    <TextBlock Text="{DynamicResource Cleanup_StartupTitle}" FontWeight="SemiBold" FontSize="15" Margin="0,8,0,2"
                               Foreground="{DynamicResource SolventTextPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource Cleanup_StartupDesc}" FontSize="12"
                               TextWrapping="Wrap" Foreground="{DynamicResource SolventTextSecondaryBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource SolventCard}" Margin="4,0,4,0" Cursor="Hand" MouseLeftButtonUp="ScheduleCard_OnClick">
                <StackPanel>
                    <ui:SymbolIcon Symbol="CalendarClock24" Foreground="{DynamicResource SolventAccentBrush}" FontSize="22" />
                    <TextBlock Text="{DynamicResource Cleanup_ScheduleTitle}" FontWeight="SemiBold" FontSize="15" Margin="0,8,0,2"
                               Foreground="{DynamicResource SolventTextPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource Cleanup_ScheduleDesc}" FontSize="12"
                               TextWrapping="Wrap" Foreground="{DynamicResource SolventTextSecondaryBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource SolventCard}" Margin="4,0,4,0" Cursor="Hand" MouseLeftButtonUp="LargeFiles_OnClick">
                <StackPanel>
                    <ui:SymbolIcon Symbol="DocumentSearch24" Foreground="{DynamicResource SolventAccentBrush}" FontSize="22" />
                    <TextBlock Text="{DynamicResource Cleanup_LargeFilesTitle}" FontWeight="SemiBold" FontSize="15" Margin="0,8,0,2"
                               Foreground="{DynamicResource SolventTextPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource Cleanup_LargeFilesDesc}" FontSize="12"
                               TextWrapping="Wrap" Foreground="{DynamicResource SolventTextSecondaryBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource SolventCard}" Margin="8,0,0,0" Cursor="Hand" MouseLeftButtonUp="Duplicates_OnClick">
                <StackPanel>
                    <ui:SymbolIcon Symbol="Copy24" Foreground="{DynamicResource SolventAccentBrush}" FontSize="22" />
                    <TextBlock Text="{DynamicResource Cleanup_DuplicatesTitle}" FontWeight="SemiBold" FontSize="15" Margin="0,8,0,2"
                               Foreground="{DynamicResource SolventTextPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource Cleanup_DuplicatesDesc}" FontSize="12"
                               TextWrapping="Wrap" Foreground="{DynamicResource SolventTextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="4" Style="{DynamicResource SolventCard}" Padding="0" Margin="0,0,0,16"
                x:Name="LargeFilesPanel" Visibility="Collapsed" MaxHeight="260">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="18,14,18,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource Cleanup_LargeFilesHeader}" FontWeight="SemiBold" FontSize="14"
                               VerticalAlignment="Center" Foreground="{DynamicResource SolventTextPrimaryBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Cleanup_ThresholdLabel}" FontSize="12" VerticalAlignment="Center"
                                   Margin="0,0,8,0" Foreground="{DynamicResource SolventTextSecondaryBrush}" />
                        <ComboBox x:Name="ThresholdCombo" Width="110" SelectedIndex="1" SelectionChanged="ThresholdCombo_OnSelectionChanged">
                            <ComboBoxItem Content="25 MB" Tag="26214400" />
                            <ComboBoxItem Content="50 MB" Tag="52428800" />
                            <ComboBoxItem Content="100 MB" Tag="104857600" />
                            <ComboBoxItem Content="500 MB" Tag="524288000" />
                            <ComboBoxItem Content="1 GB" Tag="1073741824" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <ListView Grid.Row="1" x:Name="LargeFilesList" Margin="10,0,10,10"
                          Background="Transparent" BorderThickness="0" ScrollViewer.CanContentScroll="False">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{DynamicResource Cleanup_ColFile}" Width="420" DisplayMemberBinding="{Binding FullPath}" />
                            <GridViewColumn Header="{DynamicResource Cleanup_ColSize}" Width="100" DisplayMemberBinding="{Binding SizeText}" />
                            <GridViewColumn Header="{DynamicResource Cleanup_ColModified}" Width="110" DisplayMemberBinding="{Binding LastWriteText}" />
                            <GridViewColumn Header="" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:Button Content="{DynamicResource Cleanup_OpenFolder}" Appearance="Secondary" Click="OpenFolder_OnClick" Tag="{Binding}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.Row="5" Style="{DynamicResource SolventCard}" Padding="0" Margin="0,0,0,16"
                x:Name="DuplicatesPanel" Visibility="Collapsed" MaxHeight="280">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="18,14,18,10" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:Button Content="{DynamicResource Cleanup_SelectAll}" Appearance="Secondary" Padding="12,4"
                                   Click="SelectAllDuplicates_OnClick" />
                        <ui:Button Content="{DynamicResource Cleanup_SelectNone}" Appearance="Secondary" Padding="12,4"
                                   Margin="8,0,0,0" Click="SelectNoneDuplicates_OnClick" />
                    </StackPanel>
                    <TextBlock x:Name="DuplicatesSummary" Text="{DynamicResource Cleanup_DuplicatesDefaultSummary}" FontWeight="SemiBold" FontSize="14"
                               Margin="0,0,12,0" Foreground="{DynamicResource SolventTextPrimaryBrush}" VerticalAlignment="Center" />
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,0,18,10">
                    <ItemsControl x:Name="DuplicatesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource SolventBorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding HeaderText}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SolventAccentBrush}" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding Files}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                                        <StackPanel Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding FileName}" FontSize="13"
                                                                       Foreground="{DynamicResource SolventTextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding DirectoryText}" FontSize="11"
                                                                       Foreground="{DynamicResource SolventTextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="18,0,18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="DuplicatesSelectionText" Text="{DynamicResource Cleanup_NothingSelected}" FontSize="12"
                               VerticalAlignment="Center" Foreground="{DynamicResource SolventTextSecondaryBrush}" />
                    <ui:Button Grid.Column="1" Content="{DynamicResource Cleanup_DeleteSelected}" Appearance="Primary"
                               Padding="16,8" Click="DeleteDuplicates_OnClick" x:Name="DeleteDuplicatesButton" />
                </Grid>
            </Grid>
        </Border>

        <views:ActivityLogControl Grid.Row="6" />
    </Grid>
</Page>
