<Page x:Class="SolventUI.Views.PerformancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:views="clr-namespace:SolventUI.Views"
      xmlns:conv="clr-namespace:SolventUI.Converters"
      Background="{DynamicResource SolventBgBrush}"
      Opacity="0">

    <Page.Resources>
        <conv:InverseBooleanConverter x:Key="Not" />
    </Page.Resources>

    <Page.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource PageEnterStoryboard}" />
        </EventTrigger>
    </Page.Triggers>
    <Page.RenderTransform>
        <TranslateTransform />
    </Page.RenderTransform>

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource Nav_Performance}" Style="{DynamicResource SolventSectionTitle}" />
            <TextBlock Text="{DynamicResource Perf_Subtitle}"
                       Style="{DynamicResource SolventSectionSubtitle}" />
        </StackPanel>

        <views:OperationProgressBar x:Name="ProgressPanel" Grid.Row="1" />

        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,16">
            <Border Style="{DynamicResource SolventCard}" Margin="0,0,8,0">
                <StackPanel>
                    <ui:SymbolIcon Symbol="TopSpeed24" Foreground="{DynamicResource SolventAccentBrush}" FontSize="22" />
                    <TextBlock Text="{DynamicResource Perf_OptimizeTitle}" FontWeight="SemiBold" FontSize="15" Margin="0,10,0,4"
                               Foreground="{DynamicResource SolventTextPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource Perf_OptimizeDesc}" FontSize="12"
                               TextWrapping="Wrap" Foreground="{DynamicResource SolventTextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding DriveKindText}" FontSize="11" FontStyle="Italic"
                               TextWrapping="Wrap" Foreground="{DynamicResource SolventAccentBrush}" Margin="0,0,0,10" />
                    <ui:Button Content="{DynamicResource Perf_OptimizeButton}" Appearance="Primary"
                               Command="{Binding OptimizeCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource SolventCard}" Margin="4,0,4,0">
                <StackPanel>
                    <ui:SymbolIcon Symbol="Database24" Foreground="{DynamicResource SolventAccentBrush}" FontSize="22" />
                    <TextBlock Text="{DynamicResource Perf_DiskTitle}" FontWeight="SemiBold" FontSize="15" Margin="0,10,0,4"
                               Foreground="{DynamicResource SolventTextPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource Perf_DiskDesc}" FontSize="12"
                               TextWrapping="Wrap" Foreground="{DynamicResource SolventTextSecondaryBrush}" Margin="0,0,0,14" />
                    <ui:Button Content="{DynamicResource Perf_DiskButton}" Appearance="Primary"
                               Command="{Binding CheckDiskHealthCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource SolventCard}" Margin="4,0,4,0">
                <StackPanel>
                    <ui:SymbolIcon Symbol="Wifi124" Foreground="{DynamicResource SolventAccentBrush}" FontSize="22" />
                    <TextBlock Text="{DynamicResource Perf_InternetTitle}" FontWeight="SemiBold" FontSize="15" Margin="0,10,0,4"
                               Foreground="{DynamicResource SolventTextPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource Perf_InternetDesc}" FontSize="12"
                               TextWrapping="Wrap" Foreground="{DynamicResource SolventTextSecondaryBrush}" Margin="0,0,0,14" />
                    <ui:Button Content="{DynamicResource Perf_InternetButton}" Appearance="Primary"
                               Command="{Binding TestInternetCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource SolventCard}" Margin="8,0,0,0">
                <StackPanel>
                    <ui:SymbolIcon Symbol="ArrowRepeatAll24" Foreground="{DynamicResource SolventAccentBrush}" FontSize="22" />
                    <TextBlock Text="{DynamicResource Perf_NetworkTitle}" FontWeight="SemiBold" FontSize="15" Margin="0,10,0,4"
                               Foreground="{DynamicResource SolventTextPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource Perf_NetworkDesc}" FontSize="12"
                               TextWrapping="Wrap" Foreground="{DynamicResource SolventTextSecondaryBrush}" Margin="0,0,0,14" />
                    <ui:Button Content="{DynamicResource Perf_NetworkButton}" Appearance="Primary"
                               Command="{Binding RepairNetworkCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <UniformGrid Grid.Row="3" Columns="3" Margin="0,0,0,16">
            <Border Style="{DynamicResource SolventCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Perf_DnsTitle}" FontWeight="SemiBold" FontSize="15"
                               Foreground="{DynamicResource SolventTextPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource Perf_DnsDesc}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource SolventTextSecondaryBrush}" Margin="0,2,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="{DynamicResource Perf_DnsPublicButton}" Appearance="Primary"
                                   Command="{Binding SetPublicDnsCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
                        <ui:Button Content="{DynamicResource Perf_DnsAutoButton}" Appearance="Secondary"
                                   Command="{Binding ResetDnsCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource SolventCard}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Perf_BatteryTitle}" FontWeight="SemiBold" FontSize="15"
                               Foreground="{DynamicResource SolventTextPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource Perf_BatteryDesc}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource SolventTextSecondaryBrush}" Margin="0,2,0,10" />
                    <ui:Button Content="{DynamicResource Perf_BatteryButton}" Appearance="Primary"
                               Command="{Binding GenerateBatteryReportCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource SolventCard}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Perf_MemoryTitle}" FontWeight="SemiBold" FontSize="15"
                               Foreground="{DynamicResource SolventTextPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource Perf_MemoryDesc}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource SolventTextSecondaryBrush}" Margin="0,2,0,10" />
                    <ui:Button Content="{DynamicResource Perf_MemoryButton}" Appearance="Primary"
                               Command="{Binding FreeMemoryCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding MemoryResultText}" FontSize="12" Margin="0,8,0,0"
                               Foreground="{DynamicResource SolventAccentBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="4" Style="{DynamicResource SolventCard}" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                        <ui:Button Content="{DynamicResource Perf_DriverButton}" Appearance="Primary"
                                   Command="{Binding CheckDriverUpdatesCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
                        <ui:Button Content="{DynamicResource Perf_OpenWindowsUpdate}" Appearance="Secondary"
                                   Command="{Binding OpenWindowsUpdateCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel MinWidth="120">
                        <TextBlock Text="{DynamicResource Perf_DriverTitle}" FontWeight="SemiBold" FontSize="15"
                                   Foreground="{DynamicResource SolventTextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Perf_DriverDesc}" FontSize="12"
                                   TextWrapping="Wrap" Foreground="{DynamicResource SolventTextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
                    <TextBlock Text="{Binding DriverUpdatesSummary}" FontSize="12"
                               Foreground="{DynamicResource SolventTextSecondaryBrush}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding DriverUpdates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource SolventTextSecondaryBrush}" BorderThickness="0,0,0,1"
                                        Opacity="0.9" Padding="0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SolventTextPrimaryBrush}" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource SolventTextSecondaryBrush}">
                                            <Run Text="{Binding Manufacturer, TargetNullValue={StaticResource Perf_UnknownManufacturer}}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding VersionDate, TargetNullValue={StaticResource Perf_DateUnknown}}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>

        <views:ActivityLogControl Grid.Row="5" />
    </Grid>
</Page>
