<Page x:Class="SolventUI.Views.DiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:SolventUI.Converters"
      Background="{DynamicResource SolventBgBrush}"
      Opacity="0">

    <Page.Resources>
        <conv:IssueSeverityToBrushConverter x:Key="SeverityToBrush" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    </Page.Resources>

    <Page.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource PageEnterStoryboard}" />
        </EventTrigger>
    </Page.Triggers>
    <Page.RenderTransform>
        <TranslateTransform />
    </Page.RenderTransform>

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource Nav_HealthCheck}" Style="{DynamicResource SolventSectionTitle}" />
            <TextBlock Text="{DynamicResource Diag_Subtitle}"
                       Style="{DynamicResource SolventSectionSubtitle}" />
        </StackPanel>

        <!-- Score card -->
        <Border Grid.Row="1" Style="{DynamicResource SolventCard}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0" Width="90">
                    <TextBlock x:Name="ScoreText" Text="—" FontSize="40" FontWeight="Bold"
                               Foreground="{DynamicResource SolventAccentBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Diag_ScoreLabel}" FontSize="10" HorizontalAlignment="Center"
                               Foreground="{DynamicResource SolventTextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryText" Text="{DynamicResource Diag_DefaultSummary}"
                               FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"
                               Foreground="{DynamicResource SolventTextPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource Diag_Hint}" FontSize="12" Margin="0,4,0,0"
                               Foreground="{DynamicResource SolventTextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <ui:Button x:Name="RunButton" Content="{DynamicResource Diag_RunButton}" Appearance="Primary"
                               Padding="20,10" Click="RunHealthCheck_OnClick">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Pulse24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button x:Name="ExportButton" Content="{DynamicResource Diag_ExportButton}" Appearance="Secondary"
                               Padding="20,10" Margin="0,8,0,0" IsEnabled="False" Click="Export_OnClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Issues list -->
        <Border Grid.Row="2" Style="{DynamicResource SolventCard}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource Diag_FindingsHeader}" FontWeight="SemiBold" FontSize="14" Margin="18,14,18,10"
                           Foreground="{DynamicResource SolventTextPrimaryBrush}" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,0,18,16">
                    <ItemsControl x:Name="IssuesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource SolventBorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,2,14,0"
                                                Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                                                SnapsToDevicePixels="True" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                       Foreground="{DynamicResource SolventTextPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SolventTextSecondaryBrush}" />
                                        </StackPanel>

                                        <ui:Button Grid.Column="2" Content="{Binding FixLabel}" Appearance="Primary"
                                                   Margin="14,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding FixActionId, Converter={StaticResource NullToVisibility}}"
                                                   Click="Fix_OnClick" Tag="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
