<Page x:Class="SolventUI.Views.ScheduleManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:SolventUI.Converters"
      Background="{DynamicResource SolventBgBrush}"
      Opacity="0">

    <Page.Resources>
        <conv:DayOfWeekToTagConverter x:Key="DayTag" />
        <conv:InverseBooleanConverter x:Key="Not" />
    </Page.Resources>

    <Page.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource PageEnterStoryboard}" />
        </EventTrigger>
    </Page.Triggers>
    <Page.RenderTransform>
        <TranslateTransform />
    </Page.RenderTransform>

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{DynamicResource SolventIconChip}" Margin="0,0,14,0">
                <ui:SymbolIcon Symbol="CalendarClock24" FontSize="20" Foreground="{DynamicResource SolventAccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Schedule_PageTitle}" Style="{DynamicResource SolventSectionTitle}" Margin="0" />
                <TextBlock Text="{DynamicResource Schedule_Subtitle}" Style="{DynamicResource SolventSectionSubtitle}" Margin="0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{DynamicResource SolventCard}" MaxWidth="480" HorizontalAlignment="Left">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Schedule_EnableLabel}" FontWeight="SemiBold"
                               Foreground="{DynamicResource SolventTextPrimaryBrush}" VerticalAlignment="Center" />
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                </Grid>

                <TextBlock Text="{DynamicResource Schedule_DayLabel}" FontSize="12" Margin="0,0,0,6"
                           Foreground="{DynamicResource SolventTextSecondaryBrush}" />
                <ComboBox Margin="0,0,0,16" SelectedValuePath="Tag"
                          SelectedValue="{Binding SelectedDay, Converter={StaticResource DayTag}, Mode=TwoWay}">
                    <ComboBoxItem Content="{DynamicResource Schedule_Monday}" Tag="Monday" IsSelected="True" />
                    <ComboBoxItem Content="{DynamicResource Schedule_Tuesday}" Tag="Tuesday" />
                    <ComboBoxItem Content="{DynamicResource Schedule_Wednesday}" Tag="Wednesday" />
                    <ComboBoxItem Content="{DynamicResource Schedule_Thursday}" Tag="Thursday" />
                    <ComboBoxItem Content="{DynamicResource Schedule_Friday}" Tag="Friday" />
                    <ComboBoxItem Content="{DynamicResource Schedule_Saturday}" Tag="Saturday" />
                    <ComboBoxItem Content="{DynamicResource Schedule_Sunday}" Tag="Sunday" />
                </ComboBox>

                <TextBlock Text="{DynamicResource Schedule_TimeLabel}" FontSize="12" Margin="0,0,0,6"
                           Foreground="{DynamicResource SolventTextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <ComboBox Width="80" ItemsSource="{Binding Hours}" SelectedItem="{Binding SelectedHour, Mode=TwoWay}" />
                    <TextBlock Text=":" VerticalAlignment="Center" Margin="8,0"
                               Foreground="{DynamicResource SolventTextPrimaryBrush}" />
                    <ComboBox Width="80" ItemsSource="{Binding Minutes}" SelectedItem="{Binding SelectedMinute, Mode=TwoWay}" />
                </StackPanel>

                <ui:Button Content="{DynamicResource Schedule_SaveButton}" Appearance="Primary"
                           Command="{Binding SaveCommand}" IsEnabled="{Binding IsSaving, Converter={StaticResource Not}}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
