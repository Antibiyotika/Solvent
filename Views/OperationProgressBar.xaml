<UserControl x:Class="SolventUI.Views.OperationProgressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root"
             Visibility="Collapsed">
    <Border Style="{DynamicResource SolventCard}" Margin="0,0,0,16">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Text="{DynamicResource Progress_Running}" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource SolventTextPrimaryBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <ui:Button x:Name="CancelButton" Grid.Column="1" Content="{DynamicResource Progress_Cancel}" Appearance="Secondary"
                           Padding="14,4" Margin="12,0,0,0" Click="CancelButton_OnClick" />
            </Grid>
            <ProgressBar x:Name="Bar" Height="6" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="0" />
        </StackPanel>
    </Border>
</UserControl>
