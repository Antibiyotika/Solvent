<Application x:Class="SolventUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF-UI base Fluent styling (controls, typography, Mica/Acrylic brushes) -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <!-- Solvent's own charcoal + green accent palette, layered on top.
                     Placeholder entries — ThemeService/LocalizationService swap
                     these two for the saved theme/language before the first
                     window is shown (see App.xaml.cs OnStartup). Listed here
                     too so the designer/XAML editor still resolves keys. -->
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Strings.en.xaml" />
                <ResourceDictionary Source="Themes/Animations.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
