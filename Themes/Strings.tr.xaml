    <sys:String x:Key="Diag_Hint">Bir düzeltme düğmesine basana kadar hiçbir şey değiştirilmez.</sys:String>
    <sys:String x:Key="Diag_RunButton">Sağlık kontrolü çalıştır</sys:String>
    <sys:String x:Key="Diag_ExportButton">Raporu dışa aktar</sys:String>
    <sys:String x:Key="Diag_FindingsHeader">Bulgular</sys:String>
