<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette mirrors the original Win32/GDI+ dashboard:
         charcoal sidebar/top bar, near-black content, raised card surfaces,
         a single green accent, and color-coded log entries. -->

    <Color x:Key="SolventBgColor">#0E0E10</Color>
    <Color x:Key="SolventChromeColor">#18181B</Color>
    <Color x:Key="SolventCardColor">#1F1F23</Color>
    <Color x:Key="SolventCardHoverColor">#27272B</Color>
    <Color x:Key="SolventBorderColor">#2A2A2E</Color>
    <Color x:Key="SolventAccentColor">#22C55E</Color>
    <Color x:Key="SolventAccentHoverColor">#3DDC73</Color>
    <Color x:Key="SolventTextPrimaryColor">#F4F4F5</Color>
    <Color x:Key="SolventTextSecondaryColor">#A1A1AA</Color>
    <Color x:Key="SolventInfoColor">#7DD3FC</Color>
    <Color x:Key="SolventSuccessColor">#4ADE80</Color>
    <Color x:Key="SolventWarningColor">#FBBF24</Color>
    <Color x:Key="SolventErrorColor">#F87171</Color>

    <SolidColorBrush x:Key="SolventBgBrush" Color="{StaticResource SolventBgColor}" />
    <SolidColorBrush x:Key="SolventChromeBrush" Color="{StaticResource SolventChromeColor}" />
    <SolidColorBrush x:Key="SolventCardBrush" Color="{StaticResource SolventCardColor}" />
    <SolidColorBrush x:Key="SolventCardHoverBrush" Color="{StaticResource SolventCardHoverColor}" />
    <SolidColorBrush x:Key="SolventBorderBrush" Color="{StaticResource SolventBorderColor}" />
    <SolidColorBrush x:Key="SolventAccentBrush" Color="{StaticResource SolventAccentColor}" />
    <SolidColorBrush x:Key="SolventAccentHoverBrush" Color="{StaticResource SolventAccentHoverColor}" />
    <SolidColorBrush x:Key="SolventTextPrimaryBrush" Color="{StaticResource SolventTextPrimaryColor}" />
    <SolidColorBrush x:Key="SolventTextSecondaryBrush" Color="{StaticResource SolventTextSecondaryColor}" />
    <SolidColorBrush x:Key="SolventInfoBrush" Color="{StaticResource SolventInfoColor}" />
    <SolidColorBrush x:Key="SolventSuccessBrush" Color="{StaticResource SolventSuccessColor}" />
    <SolidColorBrush x:Key="SolventWarningBrush" Color="{StaticResource SolventWarningColor}" />
    <SolidColorBrush x:Key="SolventErrorBrush" Color="{StaticResource SolventErrorColor}" />

    <Style x:Key="SolventCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SolventCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolventBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource SolventCardHoverColor}" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1.015" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1.015" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource SolventCardColor}" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SolventSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SolventTextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="SolventSectionSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource SolventTextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,18" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
