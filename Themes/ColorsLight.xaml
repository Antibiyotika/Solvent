<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light counterpart of Colors.xaml — same keys/structure, swapped at
         runtime by ThemeService. Shadows are softer/greyer than the dark
         palette's pure-black ones so cards read as "raised paper", not smudged. -->

    <Color x:Key="SolventBgColor">#F3F3F5</Color>
    <Color x:Key="SolventChromeColor">#FFFFFF</Color>
    <Color x:Key="SolventCardColor">#FFFFFF</Color>
    <Color x:Key="SolventCardHoverColor">#F5F6F8</Color>
    <Color x:Key="SolventCardActiveColor">#ECEDF0</Color>
    <Color x:Key="SolventBorderColor">#E2E3E7</Color>
    <Color x:Key="SolventBorderStrongColor">#CBCCD2</Color>
    <Color x:Key="SolventAccentColor">#16A34A</Color>
    <Color x:Key="SolventAccentHoverColor">#15803D</Color>
    <Color x:Key="SolventTextPrimaryColor">#18181B</Color>
    <Color x:Key="SolventTextSecondaryColor">#52525B</Color>
    <Color x:Key="SolventTextTertiaryColor">#8A8A93</Color>
    <Color x:Key="SolventInfoColor">#0284C7</Color>
    <Color x:Key="SolventSuccessColor">#16A34A</Color>
    <Color x:Key="SolventWarningColor">#B45309</Color>
    <Color x:Key="SolventErrorColor">#DC2626</Color>
    <Color x:Key="SolventShadowColor">#8A8A9A</Color>

    <SolidColorBrush x:Key="SolventBgBrush" Color="{StaticResource SolventBgColor}" />
    <SolidColorBrush x:Key="SolventChromeBrush" Color="{StaticResource SolventChromeColor}" />
    <SolidColorBrush x:Key="SolventCardBrush" Color="{StaticResource SolventCardColor}" />
    <SolidColorBrush x:Key="SolventCardHoverBrush" Color="{StaticResource SolventCardHoverColor}" />
    <SolidColorBrush x:Key="SolventCardActiveBrush" Color="{StaticResource SolventCardActiveColor}" />
    <SolidColorBrush x:Key="SolventBorderBrush" Color="{StaticResource SolventBorderColor}" />
    <SolidColorBrush x:Key="SolventBorderStrongBrush" Color="{StaticResource SolventBorderStrongColor}" />
    <SolidColorBrush x:Key="SolventAccentBrush" Color="{StaticResource SolventAccentColor}" />
    <SolidColorBrush x:Key="SolventAccentHoverBrush" Color="{StaticResource SolventAccentHoverColor}" />
    <SolidColorBrush x:Key="SolventTextPrimaryBrush" Color="{StaticResource SolventTextPrimaryColor}" />
    <SolidColorBrush x:Key="SolventTextSecondaryBrush" Color="{StaticResource SolventTextSecondaryColor}" />
    <SolidColorBrush x:Key="SolventTextTertiaryBrush" Color="{StaticResource SolventTextTertiaryColor}" />
    <SolidColorBrush x:Key="SolventInfoBrush" Color="{StaticResource SolventInfoColor}" />
    <SolidColorBrush x:Key="SolventSuccessBrush" Color="{StaticResource SolventSuccessColor}" />
    <SolidColorBrush x:Key="SolventWarningBrush" Color="{StaticResource SolventWarningColor}" />
    <SolidColorBrush x:Key="SolventErrorBrush" Color="{StaticResource SolventErrorColor}" />

    <SolidColorBrush x:Key="SolventAccentSoftBrush" Color="{DynamicResource SolventAccentColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="SolventAccentSofterBrush" Color="{DynamicResource SolventAccentColor}" Opacity="0.06" />
    <SolidColorBrush x:Key="SolventInfoSoftBrush" Color="{StaticResource SolventInfoColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="SolventSuccessSoftBrush" Color="{StaticResource SolventSuccessColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="SolventWarningSoftBrush" Color="{StaticResource SolventWarningColor}" Opacity="0.14" />
    <SolidColorBrush x:Key="SolventErrorSoftBrush" Color="{StaticResource SolventErrorColor}" Opacity="0.12" />

    <LinearGradientBrush x:Key="SolventAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{DynamicResource SolventAccentColor}" />
        <GradientStop Offset="1" Color="{DynamicResource SolventAccentHoverColor}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SolventHeroSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="1" Color="#F1F4F2" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="SolventCardShadowEffect" Color="{StaticResource SolventShadowColor}"
                       Opacity="0.16" BlurRadius="16" ShadowDepth="4" Direction="270" />
    <DropShadowEffect x:Key="SolventElevatedShadowEffect" Color="{StaticResource SolventShadowColor}"
                       Opacity="0.22" BlurRadius="26" ShadowDepth="8" Direction="270" />

    <Style x:Key="SolventCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SolventCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SolventBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource SolventShadowColor}" Opacity="0.14"
                                   BlurRadius="14" ShadowDepth="3" Direction="270" />
            </Setter.Value>
        </Setter>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource SolventCardHoverColor}" Duration="0:0:0.15" />
                            <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                            To="{StaticResource SolventBorderStrongColor}" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1.012" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1.012" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource SolventCardColor}" Duration="0:0:0.2" />
                            <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                            To="{StaticResource SolventBorderColor}" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SolventStaticCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SolventCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SolventBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Effect" Value="{StaticResource SolventCardShadowEffect}" />
    </Style>

    <Style x:Key="SolventHeroCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SolventHeroSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SolventAccentSoftBrush}" />
        <Setter Property="BorderThickness" Value="1.25" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Effect" Value="{StaticResource SolventElevatedShadowEffect}" />
    </Style>

    <Style x:Key="SolventIconChip" TargetType="Border">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Background" Value="{DynamicResource SolventAccentSoftBrush}" />
    </Style>

    <Style x:Key="SolventSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SolventTextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="SolventSectionSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource SolventTextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,18" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
